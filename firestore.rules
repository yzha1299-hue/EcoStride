rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Each user's role assignment. Written once at registration and never
    // editable afterwards, so a signed-in client cannot grant itself a
    // higher-privilege role by rewriting its own document or local storage.
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;

      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['email', 'role', 'createdAt'])
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role in ['participant', 'clubMember'];

      allow update: if false;
      allow delete: if false;
    }

    // One rating document per user per event. A user can only ever write their
    // own rating (never someone else's), and it must be an integer 1-5 - the
    // displayed average is always computed from these real, individually-owned
    // entries, never from a client-writable aggregate counter.
    match /eventRatings/{eventId}/entries/{userId} {
      allow read: if request.auth != null;

      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['rating', 'updatedAt'])
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5;

      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Events are visible to every signed-in user. Writes are not granted here:
    // creation/editing is added for club members separately, and the
    // registeredCount is only ever changed by the server (the API Worker).
    match /events/{eventId} {
      allow read: if request.auth != null;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
